{
  "$id": "https://agent-control-plane/protocol/0.1/log.event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "const": "log.event"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object"
        },
        "instance_id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "message"
      ],
      "type": "object"
    },
    "protocol_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "protocol_version",
    "id",
    "params"
  ],
  "title": "log.event",
  "type": "object"
}
