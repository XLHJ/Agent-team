{
  "$id": "https://agent-control-plane/protocol/0.1/agent.status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "const": "agent.status"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "current_task_id": {
          "type": "string"
        },
        "instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "idle",
            "busy",
            "waiting_approval",
            "error"
          ]
        }
      },
      "required": [
        "instance_id",
        "status"
      ],
      "type": "object"
    },
    "protocol_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "protocol_version",
    "id",
    "params"
  ],
  "title": "agent.status",
  "type": "object"
}
