{
  "$id": "https://agent-control-plane/protocol/0.1/task.progress.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "const": "task.progress"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "eta_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "step": {
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        },
        "token_used": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "progress",
        "step"
      ],
      "type": "object"
    },
    "protocol_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "protocol_version",
    "id",
    "params"
  ],
  "title": "task.progress",
  "type": "object"
}
